{
	"name": "xchert/util",
	"type": "library",
	"description": "Lightweight PHP utility library for structured data handling, JSON operations, reflection helpers, type utilities and more common tasks.",
	"keywords": [
		"utility",
		"utilities",
		"json",
		"reflection",
		"types",
		"structured-data",
		"data-structures",
		"helpers"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Dustin Simon"
		}
	],
	"support": {
		"issues": "https://github.com/x-chert/util/issues",
		"source": "https://github.com/x-chert/util"
	},
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Xchert\\Util\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xchert\\Util\\Test\\": "tests/"
		}
	},
	"require": {
		"php": "^8.4"
	},
	"require-dev": {
		"phpunit/phpunit": "~13.3.1"
	},
	"archive": {
		"exclude": [
			"/.github"
		]
	}
}
